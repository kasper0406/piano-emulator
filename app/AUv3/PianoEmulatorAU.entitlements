<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The whole of what the appex asks the system for: to be sandboxed. No
  filesystem, no network, no IOKit, no user-selected files — which is what
  makes `sandboxSafe = true` in Info.plist an honest claim rather than a hope.

  Entitlements are per-process and a plugin inherits the host's, so nothing
  here takes effect when a DAW loads us; it is the appex's own process
  (auval, and any out-of-process host) that runs under it.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
