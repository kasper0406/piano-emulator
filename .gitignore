target
renders/
.DS_Store

# The Swift side's derived output. `app/PianoEmulator.xcodeproj` is *generated*
# from `app/project.yml` by XcodeGen on every `app/build.sh`, so committing it
# would be committing a build artifact — and a four-thousand-line one that no
# reviewer can read. `app/.build` is the derived data and `app/build` the
# finished, ad-hoc-signed bundles.
/app/PianoEmulator.xcodeproj/
/app/.build/
/app/build/

# The datasets and the caches, which are large, derived and downloadable — but
# not the fetch script that downloads them. `data/fetch_salamander.sh` is the
# first line of `README.md`'s reproduction recipe and carries the URL, the size
# and the sha256 of the 707 MiB archive: ignoring it made the recipe
# unrunnable from a fresh checkout, which is the one thing an open-source
# measurement pipeline has to be (`DECISIONS.md` 65, 324).
/data/*
!/data/fetch_salamander.sh
!/data/fetch_bitklavier.sh
!/data/fetch_vcsl_knight_upright.sh
